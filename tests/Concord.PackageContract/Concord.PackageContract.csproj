<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/Fork.targets" Condition="'$(TargetFramework)' == 'net10.0'"/>

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- A throwaway consumer, not a published surface: no doc comments to satisfy SA1600's family. -->
    <NoWarn>$(NoWarn);SA1600;SA1601;SA1602;SA1611;SA1615;SA1618</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concord.Ref" Version="0.0.0-contract"/>
    <PackageReference Include="Concord.Runtime" Version="0.0.0-contract" ExcludeAssets="all" GeneratePathProperty="true"/>
    <PackageReference Include="Concord.Analyzers" Version="0.0.0-contract" PrivateAssets="all"/>
    <PackageReference Include="Concord.Generators" Version="0.0.0-contract" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Concord.Waylith" Version="0.0.0-contract"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Concord.MonoMod" Version="0.0.0-contract"/>
    <PackageReference Include="Concord.HarmonyX" Version="0.0.0-contract"/>
  </ItemGroup>

</Project>
