<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0"/>
    <PackageReference Include="xunit" Version="2.9.3"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
  </ItemGroup>
  <ItemGroup>
    <!-- PublicSurfaceTests reads the ref project's own Compile globs, so the list of assemblies it
         scans comes from the file that decides that list rather than a copy of it. -->
    <None Include="../../src/core/Concord.Ref/Concord.Ref.csproj" Link="Concord.Ref.csproj" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/core/Concord.Orchestration/Concord.Orchestration.csproj"/>
    <ProjectReference Include="../../src/core/Concord.Emit/Concord.Emit.csproj"/>
    <ProjectReference Include="../../src/core/Concord.Backend/Concord.Backend.csproj"/>
    <ProjectReference Include="../Concord.Orchestration.Tests.RollbackAssembly/Concord.Orchestration.Tests.RollbackAssembly.csproj"/>
    <ProjectReference Include="../Concord.Orchestration.Tests.RegistryAssembly/Concord.Orchestration.Tests.RegistryAssembly.csproj"/>
    <!-- Referenced only so PublicSurfaceTests can read the analyzer's twin of the [Local] position
         help string out of the built assembly. Loaded by name, never compiled against. -->
    <ProjectReference Include="../../src/core/Concord.Analyzers/Concord.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
