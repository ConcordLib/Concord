<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/core/Shared/Polyfills.cs" Link="Polyfills.cs"/>
  </ItemGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <ProjectReference Include="../../src/core/Concord.Emit/Concord.Emit.csproj"/>
  </ItemGroup>

  <!-- On net472 the targets run beside the ILRepack-merged Concord.dll. Compiling them against the
       unmerged Concord.Emit would give their signatures a ControlHandle from a second assembly, and
       the composer would not recognise it as the protocol type. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <ProjectReference Include="../../src/core/Concord/Concord.csproj" ReferenceOutputAssembly="false"/>
    <Reference Include="Concord">
      <HintPath>../../Assemblies/net472/Concord.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
