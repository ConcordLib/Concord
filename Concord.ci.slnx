<!--
  CI solution: every project that compiles and tests against -p:ForkRuntimeDir, a directory of
  the WaylithCLR fork's own framework assemblies. A runner points that property at a game image
  it downloaded; a developer's machine points it at a local checkout. Concord.slnx is the full
  developer solution. The fork test project, tests/Concord.Host.Adapter.ForkTests, is in neither
  solution: its build fails without a fork runtime, so tests/Concord.Host.Adapter.ForkTests/run-fork-tests.sh
  builds and runs it.
-->
<Solution>
  <Folder Name="/src/">
    <Project Path="src/Concord/Concord.csproj"/>
    <Project Path="src/Concord.Analyzers/Concord.Analyzers.csproj"/>
    <Project Path="src/Concord.Generators/Concord.Generators.csproj"/>
    <Project Path="src/Concord.Detour/Concord.Detour.csproj"/>
    <Project Path="src/Concord.Emit/Concord.Emit.csproj"/>
    <Project Path="src/Concord.AttachedData/Concord.AttachedData.csproj"/>
    <Project Path="src/Concord.Orchestration/Concord.Orchestration.csproj"/>
    <Project Path="src/Concord.Enums/Concord.Enums.csproj"/>
    <Project Path="src/Concord.Ref/Concord.Ref.csproj"/>
    <Project Path="src/Concord.Host.Adapter/Concord.Host.Adapter.csproj"/>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Concord.Analyzers.Tests/Concord.Analyzers.Tests.csproj"/>
    <Project Path="tests/Concord.Generators.Tests/Concord.Generators.Tests.csproj"/>
    <Project Path="tests/Concord.Detour.Tests/Concord.Detour.Tests.csproj"/>
    <Project Path="tests/Concord.Emit.Tests/Concord.Emit.Tests.csproj"/>
    <Project Path="tests/Concord.Emit.Tests.ForeignTargets/Concord.Emit.Tests.ForeignTargets.csproj"/>
    <Project Path="tests/Concord.AttachedData.Tests/Concord.AttachedData.Tests.csproj"/>
    <Project Path="tests/Concord.Enums.Tests/Concord.Enums.Tests.csproj"/>
    <Project Path="tests/Concord.Orchestration.Tests/Concord.Orchestration.Tests.csproj"/>
    <Project Path="tests/Concord.Orchestration.Tests.RegistryAssembly/Concord.Orchestration.Tests.RegistryAssembly.csproj"/>
    <Project Path="tests/Concord.Generators.Tests.Consumer/Concord.Generators.Tests.Consumer.csproj"/>
    <Project Path="tests/Concord.Host.Adapter.Tests/Concord.Host.Adapter.Tests.csproj"/>
  </Folder>
  <Folder Name="/bench/">
    <Project Path="bench/Concord.Benchmarks/Concord.Benchmarks.csproj"/>
  </Folder>
</Solution>
