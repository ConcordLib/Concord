<Project>
  <Target Name="DefineConcordAttributesInMetadata" BeforeTargets="CoreCompile" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);CONCORD_ATTRIBUTES_IN_METADATA</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
