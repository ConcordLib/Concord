<Project>
  <Target Name="MergeConcord" AfterTargets="Build">
    <PropertyGroup>
      <ConcordAssembliesDir>$(MSBuildThisFileDirectory)../../../Assemblies/$(TargetFramework)/</ConcordAssembliesDir>
      <ConcordMergedDll>$(IntermediateOutputPath)merged/Concord.dll</ConcordMergedDll>
      <ConcordMergedPdb>$(IntermediateOutputPath)merged/Concord.pdb</ConcordMergedPdb>
    </PropertyGroup>
    <ItemGroup>
      <ConcordMergeInputs Include="$(OutputPath)Concord.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)Concord.Backend.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)Concord.AttachedData.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)Concord.Orchestration.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)Concord.Enums.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)Concord.Emit.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)Mono.Cecil*.dll"/>
      <ConcordMergeInputs Include="$(OutputPath)System.*.dll" Condition="'$(TargetFramework)' == 'net472'"/>
      <ConcordMergeLib Include="$(TargetRuntimeDir)" Condition="'$(TargetRuntimeDir)' != ''"/>
      <ConcordMergeLib Include="$(OutputPath)"/>
      <ConcordMergeLib Include="$(TargetFrameworkRootPath).NETFramework/v4.7.2" Condition="'$(TargetFramework)' == 'net472'"/>
      <ConcordInternalizeExclude Include="^Concord[.]"/>
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)merged/"/>
    <ILRepack
      Parallel="true"
      DebugInfo="true"
      Internalize="true"
      InternalizeExclude="@(ConcordInternalizeExclude)"
      AllowedDuplicateNamespaces="System.Runtime.CompilerServices"
      InputAssemblies="@(ConcordMergeInputs)"
      LibraryPath="@(ConcordMergeLib)"
      TargetKind="Dll"
      OutputFile="$(ConcordMergedDll)"/>
    <MakeDir Directories="$(ConcordAssembliesDir)"/>
    <Copy SourceFiles="$(ConcordMergedDll)" DestinationFiles="$(ConcordAssembliesDir)Concord.dll.tmp"/>
    <Move SourceFiles="$(ConcordAssembliesDir)Concord.dll.tmp" DestinationFiles="$(ConcordAssembliesDir)Concord.dll"/>
    <Copy SourceFiles="$(OutputPath)Concord.xml" DestinationFiles="$(ConcordAssembliesDir)Concord.xml.tmp" Condition="Exists('$(OutputPath)Concord.xml')"/>
    <Move SourceFiles="$(ConcordAssembliesDir)Concord.xml.tmp" DestinationFiles="$(ConcordAssembliesDir)Concord.xml" Condition="Exists('$(ConcordAssembliesDir)Concord.xml.tmp')"/>
    <Copy SourceFiles="$(ConcordMergedPdb)" DestinationFiles="$(ConcordAssembliesDir)Concord.pdb.tmp" Condition="Exists('$(ConcordMergedPdb)')"/>
    <Move SourceFiles="$(ConcordAssembliesDir)Concord.pdb.tmp" DestinationFiles="$(ConcordAssembliesDir)Concord.pdb" Condition="Exists('$(ConcordAssembliesDir)Concord.pdb.tmp')"/>
  </Target>
</Project>
