<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <AssemblyName>Concord</AssemblyName>
    <RootNamespace>Concord</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <PackageId>Concord.Runtime</PackageId>
    <Description>The Concord runtime assembly: the single merged Concord.dll a target runtime ships and loads to run patches. Mods compile against Concord.Ref; this package is for runtime integrators.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <WarningsNotAsErrors>NU5128</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
    <None Include="build\Concord.Runtime.props" Pack="true" PackagePath="build;buildTransitive"/>
    <None Include="../../../Assemblies/net10.0/Concord.dll" Pack="true" PackagePath="lib/net10.0" Visible="false"/>
    <None Include="../../../Assemblies/net472/Concord.dll" Pack="true" PackagePath="lib/net472" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Concord.Backend/Concord.Backend.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../Concord.Emit/Concord.Emit.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../Concord.AttachedData/Concord.AttachedData.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../Concord.Orchestration/Concord.Orchestration.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../Concord.Enums/Concord.Enums.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../Concord.Generators/Concord.Generators.csproj" Private="false" PrivateAssets="none"/>
  </ItemGroup>

  <Target Name="KeepGeneratorsOutOfCompile" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_ResolvedProjectReferencePaths Remove="@(_ResolvedProjectReferencePaths)" Condition="'%(Filename)' == 'Concord.Generators'"/>
    </ItemGroup>
  </Target>

  <Target Name="PinGeneratorsVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferenceVersions Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]"/>
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)"/>
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferenceVersions)"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="all"/>
  </ItemGroup>

  <!-- ILRepack copies assembly attributes from the primary input only, so an InternalsVisibleTo
       for a consumer of the merged Concord.dll has to live here. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Concord.Emit.Mono.Tests"/>
    <InternalsVisibleTo Include="Concord.MonoMod.Tests"/>
  </ItemGroup>

</Project>
