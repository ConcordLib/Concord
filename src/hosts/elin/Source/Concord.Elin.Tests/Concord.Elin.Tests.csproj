<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="xunit.runner.console" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Concord.Elin/Concord.Elin.csproj" />
    <!-- Order-only: build the merged runtime first, but do not let MSBuild pick its reference,
         which resolves to the metadata-only Concord.Ref output instead of the ILRepack result. -->
    <ProjectReference Include="../../../../core/Concord/Concord.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Concord">
      <HintPath>$(ConcordCoreDir)/Assemblies/net472/Concord.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Elin">
      <HintPath>$(ElinManaged)/Elin.dll</HintPath>
    </Reference>
    <Reference Include="Plugins.BaseCore">
      <HintPath>$(ElinManaged)/Plugins.BaseCore.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ElinManaged)/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
