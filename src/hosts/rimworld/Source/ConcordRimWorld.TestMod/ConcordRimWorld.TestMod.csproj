<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ConcordRimWorldTestMod</AssemblyName>
    <RootNamespace>Concord.RimWorld.TestMod</RootNamespace>
    <OutputPath>../../TestMod/$(GameVersion)/Assemblies</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="StageTestModAbout" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)About/About.xml" DestinationFolder="$(MSBuildThisFileDirectory)../../TestMod/About" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)loadFolders.xml" DestinationFolder="$(MSBuildThisFileDirectory)../../TestMod" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamecrateRefs)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(GamecrateRefs)/UnityEngine.CoreModule.dll')">
      <HintPath>$(GamecrateRefs)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs" Condition="Exists('$(GamecrateRefs)/UnityStubs.dll')">
      <HintPath>$(GamecrateRefs)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Concord">
      <HintPath>$(ConcordCoreDir)/Assemblies/$(GameTfm)/Concord.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../core/Concord/Concord.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
