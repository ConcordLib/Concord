<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../../../Source/Directory.Build.props" />
  <Import Project="$(MSBuildThisFileDirectory)../../coex-harmony.props" />

  <PropertyGroup>
    <AssemblyName>CoexHarmonyHalf</AssemblyName>
    <RootNamespace>Concord.RimWorld.CoexTest.HarmonyHalf</RootNamespace>
    <OutputPath>../Assemblies</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamecrateRefs)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(GamecrateRefs)/UnityEngine.CoreModule.dll')">
      <HintPath>$(GamecrateRefs)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs" Condition="Exists('$(GamecrateRefs)/UnityStubs.dll')">
      <HintPath>$(GamecrateRefs)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
